# Core
APP_ENV=development
APP_NAME=AI Insurance Data Analyst V2
AUTH_ENABLED=false
APP_DATA_DIR=./data
APP_ARTIFACT_DIR=./artifacts
APP_LOG_DIR=./logs
MAX_UPLOAD_MB=200

# Gemini
GOOGLE_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-insurance-data-analyst-v2

# Optional auth users file
USERS_FILE=./data/users.json
